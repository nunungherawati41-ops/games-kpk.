<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan KPK Super - Media Pembelajaran SD Kelas 5</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Fredoka & Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        poppins: ['Poppins', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            blue: '#3B82F6',
                            yellow: '#F59E0B',
                            green: '#10B981',
                            purple: '#8B5CF6',
                            pink: '#EC4899',
                            dark: '#1E293B'
                        }
                    },
                    animation: {
                        'bounce-short': 'bounce 0.6s infinite alternate',
                        'pulse-slow': 'pulse 2s infinite',
                        'wiggle': 'wiggle 0.3s ease-in-out infinite',
                        'pop-in': 'popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
                    },
                    keyframes: {
                        wiggle: {
                            '0%, 100%': { transform: 'rotate(-3deg)' },
                            '50%': { transform: 'rotate(3deg)' },
                        },
                        popIn: {
                            '0%': { opacity: '0', transform: 'scale(0.5)' },
                            '100%': { opacity: '1', transform: 'scale(1)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #e0f2fe 0%, #f0fdf4 50%, #fef3c7 100%);
            min-height: 100vh;
            user-select: none;
        }
        h1, h2, h3, .font-fun {
            font-family: 'Fredoka', cursive;
        }
        .btn-bounce {
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .btn-bounce:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.15);
        }
        .btn-bounce:active {
            transform: translateY(1px) scale(0.98);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.08);
        }
        .box-3d {
            box-shadow: 0 8px 0 #1e40af, 0 15px 20px rgba(0,0,0,0.2);
            transition: all 0.1s ease;
        }
        .box-3d:active {
            transform: translateY(6px);
            box-shadow: 0 2px 0 #1e40af, 0 5px 10px rgba(0,0,0,0.2);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .draggable-item {
            cursor: grab;
            touch-action: none;
        }
        .draggable-item:active {
            cursor: grabbing;
        }
        .dropzone-active {
            border-color: #3b82f6 !important;
            background-color: #eff6ff !important;
        }
        .selected-item {
            ring: 4px #3b82f6 !important;
            transform: scale(1.05);
        }
    </style>
</head>
<body class="text-slate-800 flex flex-col min-h-screen">

    <!-- TOP NAVIGATION BAR -->
    <header class="sticky top-0 z-50 glass-card border-b border-sky-100 shadow-sm px-3 py-2 md:px-6 md:py-3">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            
            <!-- Logo & Mascot -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="showTab('beranda')">
                <div class="w-10 h-10 md:w-12 md:h-12 bg-amber-400 rounded-full flex items-center justify-center text-white text-xl md:text-2xl shadow-md border-2 border-amber-200 animate-bounce-short">
                    🐸
                </div>
                <div>
                    <h1 class="text-lg md:text-2xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-500 bg-clip-text text-transparent">
                        KPK Super!
                    </h1>
                    <p class="text-xs font-semibold text-sky-600 hidden sm:block">Matematika SD Kelas 5</p>
                </div>
            </div>

            <!-- Global Score & Progress Widget -->
            <div class="flex items-center space-x-2 md:space-x-4">
                <!-- Sound Toggle -->
                <button id="soundBtn" onclick="toggleSound()" class="p-2 bg-white rounded-full border-2 border-slate-200 text-slate-600 hover:text-blue-600 hover:border-blue-300 transition text-sm md:text-base" title="Suara ON/OFF">
                    <i class="fas fa-volume-up"></i>
                </button>

                <!-- Level Badge -->
                <div class="bg-indigo-100 border border-indigo-200 px-3 py-1 rounded-full flex items-center space-x-1 text-xs md:text-sm font-bold text-indigo-700">
                    <i class="fas fa-layer-group text-indigo-500"></i>
                    <span id="currentLevelText">Level 1: Mudah</span>
                </div>

                <!-- Total Score -->
                <div class="bg-amber-100 border border-amber-300 px-3 py-1 rounded-full flex items-center space-x-1.5 text-xs md:text-sm font-bold text-amber-800 shadow-inner">
                    <i class="fas fa-star text-amber-500 text-base animate-pulse"></i>
                    <span id="totalScore">0</span>
                    <span class="text-amber-600 font-normal">Poin</span>
                </div>
            </div>

            <!-- Main Navigation Links -->
            <nav class="w-full md:w-auto mt-1 md:mt-0 flex items-center justify-around md:justify-end space-x-1 md:space-x-2 overflow-x-auto py-1">
                <button onclick="showTab('beranda')" id="nav-beranda" class="nav-btn px-3 py-1.5 rounded-xl text-xs md:text-sm font-bold transition flex items-center space-x-1 border border-transparent">
                    <span>🏠</span> <span>Beranda</span>
                </button>
                <button onclick="showTab('materi')" id="nav-materi" class="nav-btn px-3 py-1.5 rounded-xl text-xs md:text-sm font-bold transition flex items-center space-x-1 border border-transparent">
                    <span>📚</span> <span>Materi</span>
                </button>
                <button onclick="showTab('simulasi')" id="nav-simulasi" class="nav-btn px-3 py-1.5 rounded-xl text-xs md:text-sm font-bold transition flex items-center space-x-1 border border-transparent">
                    <span>🔬</span> <span>Simulasi</span>
                </button>
                <button onclick="showTab('permainan')" id="nav-permainan" class="nav-btn px-3 py-1.5 rounded-xl text-xs md:text-sm font-bold transition flex items-center space-x-1 border border-transparent">
                    <span>🎮</span> <span>Permainan</span>
                </button>
                <button onclick="showTab('kuis')" id="nav-kuis" class="nav-btn px-3 py-1.5 rounded-xl text-xs md:text-sm font-bold transition flex items-center space-x-1 border border-transparent">
                    <span>📝</span> <span>Kuis</span>
                </button>
                <button onclick="showTab('hasil')" id="nav-hasil" class="nav-btn px-3 py-1.5 rounded-xl text-xs md:text-sm font-bold transition flex items-center space-x-1 border border-transparent">
                    <span>🏆</span> <span>Hasil</span>
                </button>
            </nav>

        </div>
    </header>

    <!-- GLOBAL PROGRESS BAR -->
    <div class="bg-slate-200 h-2 w-full overflow-hidden">
        <div id="globalProgressBar" class="bg-gradient-to-r from-blue-500 via-indigo-500 to-amber-400 h-full w-0 transition-all duration-500"></div>
    </div>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-3 md:px-6 py-4 md:py-6 flex-grow w-full">

        <!-- ================= TAB 1: BERANDA ================= -->
        <section id="tab-beranda" class="tab-content space-y-6">
            <!-- Hero Banner -->
            <div class="glass-card rounded-3xl p-6 md:p-10 bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-700 text-white relative overflow-hidden shadow-2xl">
                <div class="absolute -right-10 -bottom-10 opacity-20 text-9xl">🐸</div>
                <div class="max-w-2xl space-y-4 relative z-10">
                    <span class="inline-block bg-yellow-400 text-slate-900 font-black px-4 py-1 rounded-full text-xs uppercase tracking-wider shadow">
                        Petualangan Kelas 5 SD
                    </span>
                    <h2 class="text-3xl md:text-5xl font-bold font-fun leading-tight">
                        Taklukkan Kelipatan, Temukan KPK Juara! 🌟
                    </h2>
                    <p class="text-blue-100 text-sm md:text-base leading-relaxed">
                        Selamat datang, Detektif Matematika! Bersama <span class="font-bold text-yellow-300">Kipi si Katak Lompat</span>, kamu akan belajar menentukan Kelipatan Persekutuan Terkecil (KPK) dengan cara yang sangat seru, simulasi interaktif, dan berbagai permainan mini!
                    </p>
                    <div class="pt-2 flex flex-wrap gap-3">
                        <button onclick="showTab('simulasi')" class="btn-bounce bg-yellow-400 hover:bg-yellow-300 text-slate-900 font-bold px-6 py-3 rounded-2xl shadow-lg flex items-center space-x-2 text-base">
                            <span>🚀 Mulai Simulasi</span>
                        </button>
                        <button onclick="showTab('materi')" class="btn-bounce bg-white/20 hover:bg-white/30 text-white font-bold px-6 py-3 rounded-2xl backdrop-blur-md border border-white/30 text-base">
                            <span>📖 Pelajari Materi</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mascot Speech Bubble & Quick Objectives -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="glass-card p-5 rounded-2xl flex items-center space-x-4 border-l-8 border-l-blue-500">
                    <div class="text-4xl">🎯</div>
                    <div>
                        <h3 class="font-bold text-blue-900">Tujuan Pembelajaran</h3>
                        <p class="text-xs text-slate-600">Siswa dapat menentukan KPK dari dua bilangan secara cepat, tepat, dan gembira.</p>
                    </div>
                </div>

                <div class="glass-card p-5 rounded-2xl flex items-center space-x-4 border-l-8 border-l-amber-500">
                    <div class="text-4xl">💡</div>
                    <div>
                        <h3 class="font-bold text-amber-900">Konsep Utama</h3>
                        <p class="text-xs text-slate-600">Kelipatan, Kelipatan Persekutuan, dan Mencari Persekutuan Terkecil.</p>
                    </div>
                </div>

                <div class="glass-card p-5 rounded-2xl flex items-center space-x-4 border-l-8 border-l-emerald-500">
                    <div class="text-4xl">🏅</div>
                    <div>
                        <h3 class="font-bold text-emerald-900">Misi Kamu</h3>
                        <p class="text-xs text-slate-600">Selesaikan kuis, kumpulkan 5 lencana piala, dan raih Predikat KPK Master!</p>
                    </div>
                </div>
            </div>

            <!-- Quick Start Activity Grid -->
            <div class="space-y-3">
                <h3 class="text-xl font-bold font-fun text-slate-800 flex items-center space-x-2">
                    <span>⚡ Akses Cepat Aktivitas</span>
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
                    <button onclick="startQuickGame('openthebox')" class="glass-card p-4 rounded-2xl text-center hover:bg-blue-50 transition btn-bounce">
                        <div class="text-3xl mb-1">🎁</div>
                        <div class="font-bold text-xs text-slate-700">Open the Box</div>
                    </button>
                    <button onclick="startQuickGame('speed')" class="glass-card p-4 rounded-2xl text-center hover:bg-amber-50 transition btn-bounce">
                        <div class="text-3xl mb-1">⚡</div>
                        <div class="font-bold text-xs text-slate-700">Tantangan Cepat</div>
                    </button>
                    <button onclick="startQuizSection('dragdrop')" class="glass-card p-4 rounded-2xl text-center hover:bg-emerald-50 transition btn-bounce">
                        <div class="text-3xl mb-1">🖐️</div>
                        <div class="font-bold text-xs text-slate-700">Drag & Drop</div>
                    </button>
                    <button onclick="startQuizSection('fillblank')" class="glass-card p-4 rounded-2xl text-center hover:bg-purple-50 transition btn-bounce">
                        <div class="text-3xl mb-1">✍️</div>
                        <div class="font-bold text-xs text-slate-700">Isian Singkat</div>
                    </button>
                    <button onclick="startQuizSection('matching')" class="glass-card p-4 rounded-2xl text-center hover:bg-pink-50 transition btn-bounce">
                        <div class="text-3xl mb-1">🔗</div>
                        <div class="font-bold text-xs text-slate-700">Menjodohkan</div>
                    </button>
                    <button onclick="startQuizSection('truefalse')" class="glass-card p-4 rounded-2xl text-center hover:bg-sky-50 transition btn-bounce">
                        <div class="text-3xl mb-1">✔️</div>
                        <div class="font-bold text-xs text-slate-700">Benar / Salah</div>
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= TAB 2: MATERI ================= -->
        <section id="tab-materi" class="tab-content hidden space-y-6">
            <div class="glass-card p-6 md:p-8 rounded-3xl space-y-6">
                <div class="flex flex-wrap items-center justify-between border-b pb-4 gap-2">
                    <div>
                        <h2 class="text-2xl md:text-3xl font-bold font-fun text-blue-900">📚 Modul Belajar KPK</h2>
                        <p class="text-xs md:text-sm text-slate-600">Pahami konsep dasar kelipatan sebelum bertualang!</p>
                    </div>
                    <!-- Material Sub-tabs -->
                    <div class="flex space-x-1 bg-slate-100 p-1 rounded-xl">
                        <button onclick="switchMaterialTab('m1')" id="mtab-m1" class="px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition">1. Kelipatan</button>
                        <button onclick="switchMaterialTab('m2')" id="mtab-m2" class="px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition">2. Persekutuan</button>
                        <button onclick="switchMaterialTab('m3')" id="mtab-m3" class="px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition">3. Menentukan KPK</button>
                        <button onclick="switchMaterialTab('m4')" id="mtab-m4" class="px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition">4. Soal Cerita</button>
                    </div>
                </div>

                <!-- Material Section 1 -->
                <div id="materi-m1" class="materi-panel space-y-4">
                    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-xl">
                        <h3 class="font-bold text-blue-900 text-lg">Apa itu Kelipatan Bilangan?</h3>
                        <p class="text-sm text-slate-700 mt-1">
                            <strong>Kelipatan</strong> adalah hasil perkalian suatu bilangan dengan bilangan asli (1, 2, 3, 4, 5, ...).
                            Bisa juga dibayangkan seperti <em>lompatan berulang</em>!
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-white p-4 rounded-xl border shadow-sm">
                            <h4 class="font-bold text-emerald-600">Contoh Kelipatan 3:</h4>
                            <p class="text-sm mt-2 text-slate-700">
                                3 x 1 = <strong>3</strong><br>
                                3 x 2 = <strong>6</strong><br>
                                3 x 3 = <strong>9</strong><br>
                                3 x 4 = <strong>12</strong><br>
                                Kelipatan 3 = <strong>{ 3, 6, 9, 12, 15, 18, 21, ... }</strong>
                            </p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border shadow-sm">
                            <h4 class="font-bold text-amber-600">Contoh Kelipatan 4:</h4>
                            <p class="text-sm mt-2 text-slate-700">
                                4 x 1 = <strong>4</strong><br>
                                4 x 2 = <strong>8</strong><br>
                                4 x 3 = <strong>12</strong><br>
                                4 x 4 = <strong>16</strong><br>
                                Kelipatan 4 = <strong>{ 4, 8, 12, 16, 20, 24, 28, ... }</strong>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Material Section 2 -->
                <div id="materi-m2" class="materi-panel hidden space-y-4">
                    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-xl">
                        <h3 class="font-bold text-amber-900 text-lg">Apa itu Kelipatan Persekutuan & KPK?</h3>
                        <p class="text-sm text-slate-700 mt-1">
                            <strong>Kelipatan Persekutuan</strong> adalah kelipatan yang <em>sama (kembar)</em> dari dua bilangan atau lebih. <br>
                            <strong>KPK (Kelipatan Persekutuan Terkecil)</strong> adalah angka kelipatan persekutuan yang nilainya <u>paling kecil</u> (selain angka 0).
                        </p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border shadow-sm space-y-3">
                        <h4 class="font-bold text-indigo-900">Mencari KPK dari 3 dan 4:</h4>
                        <div class="text-sm space-y-1">
                            <p class="text-blue-700">● Kelipatan 3 = 3, 6, 9, <span class="bg-yellow-300 font-bold px-1 rounded">12</span>, 15, 18, 21, <span class="bg-yellow-300 font-bold px-1 rounded">24</span>, ...</p>
                            <p class="text-amber-700">● Kelipatan 4 = 4, 8, <span class="bg-yellow-300 font-bold px-1 rounded">12</span>, 16, 20, <span class="bg-yellow-300 font-bold px-1 rounded">24</span>, 28, ...</p>
                        </div>
                        <div class="p-3 bg-emerald-100 rounded-xl text-emerald-900 text-sm font-semibold">
                            ✨ Kelipatan Persekutuan: { 12, 24, ... } <br>
                            👑 Yang paling kecil adalah <strong>12</strong>. Maka **KPK(3, 4) = 12**.
                        </div>
                    </div>
                </div>

                <!-- Material Section 3 -->
                <div id="materi-m3" class="materi-panel hidden space-y-4">
                    <div class="bg-purple-50 border-l-4 border-purple-500 p-4 rounded-xl">
                        <h3 class="font-bold text-purple-900 text-lg">Metode Praktis Menentukan KPK</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-white p-4 rounded-xl border">
                            <h4 class="font-bold text-purple-700 mb-2">1. Metode Mendaftar Kelipatan</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Tuliskan kelipatan masing-masing bilangan secara berurutan sampai menemukan angka pertama yang sama! Cocok untuk angka kecil (2 sampai 12).
                            </p>
                        </div>
                        <div class="bg-white p-4 rounded-xl border">
                            <h4 class="font-bold text-pink-700 mb-2">2. Metode Faktorisasi Prima (Pohon Faktor)</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Ubah angka menjadi bentuk perkalian faktor prima. Ambil <strong>semua faktor prima</strong>, dan jika ada yang sama, ambil yang memiliki <strong>pangkat terbesar</strong>!
                            </p>
                            <div class="mt-2 text-xs bg-slate-100 p-2 rounded">
                                Contoh: 12 = 2² x 3, dan 18 = 2 x 3² <br>
                                KPK = 2² x 3² = 4 x 9 = <strong>36</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Material Section 4 -->
                <div id="materi-m4" class="materi-panel hidden space-y-4">
                    <div class="bg-pink-50 border-l-4 border-pink-500 p-4 rounded-xl">
                        <h3 class="font-bold text-pink-900 text-lg">Penerapan KPK dalam Soal Cerita</h3>
                        <p class="text-sm text-slate-700 mt-1">
                            KPK sering digunakan untuk menyelesaikan masalah kejadian berulang yang terjadi bersamaan!
                        </p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border space-y-2 text-sm">
                        <p class="font-bold text-slate-800">Kata kunci dalam soal cerita KPK:</p>
                        <div class="flex flex-wrap gap-2 text-xs">
                            <span class="bg-blue-100 text-blue-800 font-bold px-2 py-1 rounded-md">"Bersama-sama lagi"</span>
                            <span class="bg-emerald-100 text-emerald-800 font-bold px-2 py-1 rounded-md">"Setiap ... sekali"</span>
                            <span class="bg-amber-100 text-amber-800 font-bold px-2 py-1 rounded-md">"Menyala bersamaan"</span>
                            <span class="bg-purple-100 text-purple-800 font-bold px-2 py-1 rounded-md">"Berangkat bersama"</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= TAB 3: SIMULASI INTERAKTIF ================= -->
        <section id="tab-simulasi" class="tab-content hidden space-y-6">
            <div class="glass-card p-6 md:p-8 rounded-3xl space-y-6">
                <div>
                    <span class="bg-emerald-100 text-emerald-800 font-bold text-xs px-3 py-1 rounded-full uppercase">Laboratorium Interaktif</span>
                    <h2 class="text-2xl md:text-3xl font-bold font-fun text-slate-800 mt-1">🐸 Simulasi Lompatan KPK</h2>
                    <p class="text-xs md:text-sm text-slate-600">Ubah dua angka pilihanmu dan lihat bagaimana katak melompat untuk menemukan titik temu (KPK)!</p>
                </div>

                <!-- Controls Form -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-100 p-4 rounded-2xl border">
                    <div>
                        <label class="block text-xs font-bold text-blue-800 mb-1">
                            🟦 Angka Katak Pertama (A):
                        </label>
                        <select id="simNumberA" onchange="runSimulation()" class="w-full p-2.5 rounded-xl border-2 border-blue-300 font-bold text-blue-900 bg-white shadow-sm">
                            <option value="2">Katak A = 2</option>
                            <option value="3" selected>Katak A = 3</option>
                            <option value="4">Katak A = 4</option>
                            <option value="5">Katak A = 5</option>
                            <option value="6">Katak A = 6</option>
                            <option value="8">Katak A = 8</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-amber-800 mb-1">
                            🟧 Angka Katak Kedua (B):
                        </label>
                        <select id="simNumberB" onchange="runSimulation()" class="w-full p-2.5 rounded-xl border-2 border-amber-300 font-bold text-amber-900 bg-white shadow-sm">
                            <option value="2">Katak B = 2</option>
