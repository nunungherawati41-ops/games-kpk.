    <script>
        /* ==========================================================================
           STATE MANAGEMENT & AUDIO SYNTHESIZER
           ========================================================================== */
        const state = {
            soundEnabled: true,
            totalScore: 0,
            level: 1, // 1: Mudah, 2: Sedang, 3: Menantang
            completedActivities: {
                choice: false,
                dragdrop: false,
                fillblank: false,
                matching: false,
                truefalse: false,
                openthebox: false,
                speed: false
            },
            badges: [
                { id: 'b1', name: 'Penjelajah Kelipatan', icon: '🔍', desc: 'Buka media pembelajaran', unlocked: true },
                { id: 'b2', name: 'Master Buka Kotak', icon: '🎁', desc: 'Selesaikan game Open Box', unlocked: false },
                { id: 'b3', name: 'Raja Kecepatan', icon: '⚡', desc: 'Selesaikan tantangan timer', unlocked: false },
                { id: 'b4', name: 'Detektif KPK', icon: '🧩', desc: 'Selesaikan kuis Drag & Drop', unlocked: false },
                { id: 'b5', name: 'Juara KPK Super', icon: '👑', desc: 'Raih 300+ poin total', unlocked: false }
            ]
        };

        // Web Audio Synthesizer for lag-free audio
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playTone(freq, type = 'sine', duration = 0.15) {
            if (!state.soundEnabled) return;
            try {
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.log('Audio error', e);
            }
        }

        function playSoundSuccess() {
            playTone(523.25, 'triangle', 0.1); // C5
            setTimeout(() => playTone(659.25, 'triangle', 0.1), 100); // E5
            setTimeout(() => playTone(783.99, 'triangle', 0.2), 200); // G5
        }

        function playSoundWrong() {
            playTone(200, 'sawtooth', 0.2);
            setTimeout(() => playTone(150, 'sawtooth', 0.25), 150);
        }

        function playSoundClick() {
            playTone(400, 'sine', 0.05);
        }

        function toggleSound() {
            state.soundEnabled = !state.soundEnabled;
            const btn = document.getElementById('soundBtn');
            btn.innerHTML = state.soundEnabled ? '<i class="fas fa-volume-up"></i>' : '<i class="fas fa-volume-mute text-red-500"></i>';
        }

        function addScore(pts) {
            state.totalScore += pts;
            document.getElementById('totalScore').innerText = state.totalScore;
            document.getElementById('resultsTotalScore').innerText = state.totalScore;
            
            // Level Progression Logic
            if (state.totalScore >= 300) {
                state.level = 3;
                document.getElementById('currentLevelText').innerText = 'Level 3: Menantang 🔥';
            } else if (state.totalScore >= 120) {
                state.level = 2;
                document.getElementById('currentLevelText').innerText = 'Level 2: Sedang ⚡';
            }

            // Check badges
            if (state.totalScore >= 300) {
                unlockBadge('b5');
            }

            updateGlobalProgressBar();
            renderBadges();
        }

        function unlockBadge(badgeId) {
            const bg = state.badges.find(b => b.id === badgeId);
            if (bg && !bg.unlocked) {
                bg.unlocked = true;
                showModal('🏅 Lencana Baru Terbuka!', `Kamu mendapatkan Lencana "${bg.name}"!`, bg.icon, 'Teruskan prestasi hebatmu!');
                renderBadges();
            }
        }

        function updateGlobalProgressBar() {
            const keys = Object.keys(state.completedActivities);
            const done = keys.filter(k => state.completedActivities[k]).length;
            const pct = Math.min(100, Math.round((done / keys.length) * 100));
            document.getElementById('globalProgressBar').style.width = pct + '%';
            document.getElementById('resultsCompletedCount').innerText = `${done} / ${keys.length}`;
        }

        /* ==========================================================================
           TAB NAVIGATION LOGIC
           ========================================================================== */
        function showTab(tabId) {
            playSoundClick();
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white', 'shadow');
                btn.classList.add('text-slate-600', 'hover:bg-white/60');
            });

            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-600', 'hover:bg-white/60');
                activeBtn.classList.add('bg-blue-600', 'text-white', 'shadow');
            }

            if (tabId === 'simulasi') {
                runSimulation();
            } else if (tabId === 'kuis') {
                switchQuizType('choice');
            } else if (tabId === 'hasil') {
                renderBadges();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function switchMaterialTab(mId) {
            playSoundClick();
            document.querySelectorAll('.materi-panel').forEach(p => p.classList.add('hidden'));
            document.getElementById(`materi-${mId}`).classList.remove('hidden');

            ['m1', 'm2', 'm3', 'm4'].forEach(id => {
                const btn = document.getElementById(`mtab-${id}`);
                btn.className = (id === mId)
                    ? 'px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition bg-blue-600 text-white shadow'
                    : 'px-3 py-1.5 rounded-lg text-xs md:text-sm font-bold transition text-slate-600 hover:bg-slate-200';
            });
        }

        /* ==========================================================================
           MODAL & FEEDBACK SYSTEM
           ========================================================================== */
        function showModal(title, bodyText, icon = '🎉', explanation = '') {
            const modal = document.getElementById('feedbackModal');
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalBody').innerText = bodyText;
            document.getElementById('modalIcon').innerText = icon;
            
            const expBox = document.getElementById('modalExplanation');
            if (explanation) {
                expBox.classList.remove('hidden');
                expBox.innerHTML = `<strong>💡 Penjelasan:</strong><br>${explanation}`;
            } else {
                expBox.classList.add('hidden');
            }

            modal.classList.remove('hidden');

            if (icon === '🎉' || icon === '⭐' || icon === '👑' || icon === '🏆') {
                confetti({ particleCount: 50, spread: 60, origin: { y: 0.6 } });
            }
        }

        function closeModal() {
            playSoundClick();
            document.getElementById('feedbackModal').classList.add('hidden');
        }

        /* ==========================================================================
           SIMULATION ENGINE
           ========================================================================== */
        function runSimulation() {
            const numA = parseInt(document.getElementById('simNumberA').value);
            const numB = parseInt(document.getElementById('simNumberB').value);

            const grid = document.getElementById('simGrid');
            grid.innerHTML = '';

            const multiplesA = [];
            for (let i = numA; i <= 40; i += numA) multiplesA.push(i);

            const multiplesB = [];
            for (let i = numB; i <= 40; i += numB) multiplesB.push(i);

            const common = multiplesA.filter(x => multiplesB.includes(x));
            const kpkVal = common.length > 0 ? common[0] : (numA * numB);

            for (let i = 1; i <= 40; i++) {
                const isA = multiplesA.includes(i);
                const isB = multiplesB.includes(i);
                const isCommon = isA && isB;
                const isKPK = i === kpkVal;

                const cell = document.createElement('div');
                cell.id = `sim-cell-${i}`;
                cell.className = 'h-12 rounded-xl flex flex-col items-center justify-center font-bold text-sm border-2 transition-all relative ';

                if (isKPK) {
                    cell.className += 'bg-red-500 text-white border-red-600 shadow-lg scale-105 animate-pulse';
                } else if (isCommon) {
                    cell.className += 'bg-emerald-500 text-white border-emerald-600 shadow-md';
                } else if (isA) {
                    cell.className += 'bg-blue-100 text-blue-900 border-blue-400';
                } else if (isB) {
                    cell.className += 'bg-amber-100 text-amber-900 border-amber-400';
                } else {
                    cell.className += 'bg-white text-slate-600 border-slate-200';
                }

                cell.innerHTML = `
                    <span>${i}</span>
                    <span class="text-[9px] font-normal">
                        ${isKPK ? '👑 KPK' : (isCommon ? '✨ Sama' : (isA ? '🟦 A' : (isB ? '🟧 B' : '')))}
                    </span>
                `;
                grid.appendChild(cell);
            }

            // Explanation Text
            document.getElementById('simExplanation').innerHTML = `
                <div class="flex items-center space-x-2 text-emerald-900 font-bold font-fun text-lg">
                    <span>💡 Analisis Hasil Simulasi:</span>
                </div>
                <div class="text-xs sm:text-sm text-slate-700 space-y-1">
                    <p>🟦 <strong>Lompatan Katak A (${numA}):</strong> ${multiplesA.slice(0, 8).join(', ')} ...</p>
                    <p>🟧 <strong>Lompatan Katak B (${numB}):</strong> ${multiplesB.slice(0, 8).join(', ')} ...</p>
                    <p>✨ <strong>Kelipatan Persekutuan (Titik Temu):</strong> { ${common.slice(0, 5).join(', ')} }</p>
                    <p class="text-base font-bold text-red-600 pt-1">
                        👑 Maka, KPK dari ${numA} dan ${numB} adalah <span class="underline">${kpkVal}</span> (Titik temu pertama yang paling kecil).
                    </p>
                </div>
            `;
        }

        function runSimulationAnimation() {
            playSoundClick();
            const numA = parseInt(document.getElementById('simNumberA').value);
            const numB = parseInt(document.getElementById('simNumberB').value);

            let step = 1;
            const max = Math.max(numA * 4, numB * 4, 24);

            const timer = setInterval(() => {
                if (step > max) {
                    clearInterval(timer);
                    playSoundSuccess();
                    return;
                }
                const cell = document.getElementById(`sim-cell-${step}`);
                if (cell) {
                    cell.classList.add('ring-4', 'ring-yellow-400');
                    setTimeout(() => cell.classList.remove('ring-4', 'ring-yellow-400'), 300);
                }
                step++;
            }, 80);
        }

        /* ==========================================================================
           GAME 1: OPEN THE BOX
           ========================================================================== */
        const openBoxData = [
