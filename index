                `;
            });

            html += `</div></div></div>`;
            container.innerHTML = html;
        }

        function selectMatchLeft(id) {
            playSoundClick();
            document.querySelectorAll('#matchLeftCol button').forEach(b => b.classList.remove('ring-4', 'ring-purple-500'));
            const btn = document.getElementById(`mleft-${id}`);
            if (btn) {
                btn.classList.add('ring-4', 'ring-purple-500');
                selectedMatchLeft = id;
            }
        }

        function selectMatchRight(rightId) {
            if (!selectedMatchLeft) return;

            if (selectedMatchLeft === rightId) {
                playSoundSuccess();
                addScore(10);
                const lBtn = document.getElementById(`mleft-${selectedMatchLeft}`);
                const rBtn = document.getElementById(`mright-${rightId}`);

                lBtn.className = 'w-full bg-emerald-500 text-white p-3 rounded-2xl text-xs font-bold cursor-default opacity-80';
                rBtn.className = 'w-full bg-emerald-500 text-white p-3 rounded-2xl text-xs font-bold cursor-default opacity-80';
                lBtn.onclick = null;
                rBtn.onclick = null;

                showModal('🔗 Pasangan Cocok!', 'Kamu berhasil menjodohkan dengan benar!', '🎉');
                selectedMatchLeft = null;
                state.completedActivities.matching = true;
            } else {
                playSoundWrong();
                showModal('❌ Pasangan Salah', 'Cobalah mencari jawaban yang sesuai!', '😅');
            }
        }

        /* --- RENDER 5: BENAR / SALAH --- */
        function renderTrueFalseQuiz(container) {
            let html = `
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="font-bold font-fun text-lg text-rose-900">✔️ / ❌ Benar atau Salah (5 Soal)</h3>
                        <span class="text-xs bg-rose-100 text-rose-800 font-bold px-2.5 py-1 rounded-full">Bobot: 10 Poin/Soal</span>
                    </div>
            `;

            trueFalseQuestions.forEach((tf, index) => {
                html += `
                    <div class="p-4 rounded-2xl border bg-slate-50 flex flex-wrap items-center justify-between gap-3">
                        <div class="font-bold text-sm text-slate-800 max-w-md">${index + 1}. ${tf.q}</div>
                        <div class="flex space-x-2">
                            <button onclick="checkTrueFalseAnswer(${tf.id}, true)" class="btn-bounce bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-4 py-2 rounded-xl text-xs">
                                ✔️ BENAR
                            </button>
                            <button onclick="checkTrueFalseAnswer(${tf.id}, false)" class="btn-bounce bg-rose-500 hover:bg-rose-600 text-white font-bold px-4 py-2 rounded-xl text-xs">
                                ❌ SALAH
                            </button>
                        </div>
                    </div>
                `;
            });

            html += `</div>`;
            container.innerHTML = html;
        }

        function checkTrueFalseAnswer(tfId, userAns) {
            const tf = trueFalseQuestions.find(x => x.id === tfId);
            if (userAns === tf.ans) {
                playSoundSuccess();
                addScore(10);
                showModal('✅ Tepat Sekali!', 'Analisis Benar/Salah kamu akurat!', '🎉', tf.exp);
                state.completedActivities.truefalse = true;
            } else {
                playSoundWrong();
                showModal('❌ Kurang Tepat', 'Coba baca kembali pernyataan tersebut.', '🤔', tf.exp);
            }
        }

        /* ==========================================================================
           TAB 6: RESULTS & BADGES
           ========================================================================== */
        function renderBadges() {
            const grid = document.getElementById('badgesGrid');
            if (!grid) return;

            grid.innerHTML = '';
            state.badges.forEach(b => {
                const card = document.createElement('div');
                card.className = b.unlocked
                    ? 'glass-card p-4 rounded-2xl text-center border-2 border-amber-300 bg-amber-50/80 shadow-md space-y-1'
                    : 'glass-card p-4 rounded-2xl text-center border-2 border-slate-200 opacity-50 grayscale space-y-1';

                card.innerHTML = `
                    <div class="text-3xl mb-1">${b.icon}</div>
                    <div class="font-bold font-fun text-xs text-slate-800">${b.name}</div>
                    <div class="text-[10px] text-slate-500">${b.desc}</div>
                    <div class="text-[9px] font-bold ${b.unlocked ? 'text-emerald-600' : 'text-slate-400'} pt-1">
                        ${b.unlocked ? 'TERBUKA ✅' : 'TERKUNCI 🔒'}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        /* INITIALIZATION ON WINDOW LOAD */
        window.onload = function() {
            showTab('beranda');
            runSimulation();
            renderBadges();
        };
    </script>
</body>
</html>